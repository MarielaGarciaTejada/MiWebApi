@page "/calculadoramcd"
@using System.Text.Json
@inject HttpClient Http

<PageTitle>Cálculo de MCD</PageTitle>

<h3>Calculadora de Máximo Común Divisor</h3>

<p>
    Este componente consume el endpoint <code>/api/mcd?dividendo={dividendo}&divisor={divisor}</code>
    usando el <code>HttpClient</code> inyectado. Si la API no tuviera configurado CORS para el origen
    de este cliente, la petición fallaría en la consola del navegador.
</p>

<div class="mb-3">
    <label for="dividendo" class="form-label">Dividendo</label>
    <input id="dividendo" type="number" class="form-control" style="max-width: 250px;" @bind="dividendo" />
</div>

<div class="mb-3">
    <label for="divisor" class="form-label">Divisor</label>
    <input id="divisor" type="number" class="form-control" style="max-width: 250px;" @bind="divisor" />
</div>

<button class="btn btn-primary" @onclick="Calcular" disabled="@calculando">
    @(calculando ? "Calculando..." : "Calcular MCD")
</button>

@if (resultado is not null)
{
    <p class="mt-3 alert alert-success" style="max-width: 400px;">
        El MCD de @dividendoCalculado y @divisorCalculado es: <strong>@resultado</strong>
    </p>
}

@if (error is not null)
{
    <p class="mt-3 text-danger">Error: @error</p>
}

<hr class="mt-4" />

<h4>Historial de cálculos (Azure SQL)</h4>

@if (cargandoHistorial)
{
    <p><em>Cargando historial...</em></p>
}
else if (historial is null || historial.Count == 0)
{
    <p>Todavía no hay cálculos registrados.</p>
}
else
{
    <table class="table table-striped" style="max-width: 600px;">
        <thead>
            <tr>
                <th>Id</th>
                <th>Dividendo</th>
                <th>Divisor</th>
                <th>Resultado</th>
                <th>Fecha (UTC)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in historial)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Dividendo</td>
                    <td>@item.Divisor</td>
                    <td>@item.Resultado</td>
                    <td>@item.Fecha</td>
                </tr>
            }
        </tbody>
    </table>
}



@code {
    private int dividendo;
    private int divisor;
    private int dividendoCalculado;
    private int divisorCalculado;
    private string? resultado;
    private string? error;
    private bool calculando;

    private List<HistorialCalculoDto>? historial;
    private bool cargandoHistorial;

    protected override async Task OnInitializedAsync()
    {
        await CargarHistorialAsync();
    }


    private async Task Calcular()
    {
        calculando = true;
        error = null;
        resultado = null;

        try
        {
            var response = await Http.GetAsync($"api/mcd?dividendo={dividendo}&divisor={divisor}");
            var contenido = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                // aqui extrae solo la propiedad "mcd" del JSON devuelto por la API
                using var doc = JsonDocument.Parse(contenido);
                if (doc.RootElement.TryGetProperty("mcd", out var mcdProp))
                {
                    resultado = mcdProp.GetInt32().ToString();
                }
                else
                {
                    resultado = contenido;
                }

                dividendoCalculado = dividendo;
                divisorCalculado = divisor;
                await CargarHistorialAsync();
            }
            else
            {
                error = contenido;
            }
        }
        catch (Exception ex)
        {
            // Un error de red o de CORS bloqueado por el navegador cae acá.
            error = $"No se pudo contactar a la API: {ex.Message}";
        }
        finally
        {  calculando = false; }
    }


    private async Task CargarHistorialAsync()
    {
        cargandoHistorial = true;
        try
        {
            historial = await Http.GetFromJsonAsync<List<HistorialCalculoDto>>("api/historial");
        }
        catch (Exception ex)
        {
            error = $"No se pudo cargar el historial: {ex.Message}";
        }
        finally
        { cargandoHistorial = false; }
    }

    private class HistorialCalculoDto
    {
        public int Id { get; set; }
        public int Dividendo { get; set; }
        public int Divisor { get; set; }
        public int Resultado { get; set; }
        public DateTime Fecha { get; set; }
    }

}
